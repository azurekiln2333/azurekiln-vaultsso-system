{
  "name": "azurekiln-oauth2",
  "version": "1.0.0",
  "description": "AzureKiln OAuth2 and OpenID Connect provider",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "init-db": "node scripts/init-db.js",
    "check:config": "node scripts/check-config.js",
    "check:syntax": "node scripts/check-syntax.js",
    "check:e2e": "node scripts/check-e2e.js",
    "check": "npm run check:syntax && npm run check:e2e",
    "build:css": "tailwindcss -c tailwind.config.cjs -i styles/tailwind.css -o public/css/vaultsso-utilities.css --minify",
    "check:browser": "node tests/browser-smoke.cjs && node tests/account-bindings-browser.cjs && node tests/auth-feedback-browser.cjs && node tests/password-mfa-browser.cjs && node tests/multi-authenticator-browser.cjs && node tests/turnstile-browser.cjs",
    "build:fonts": "node scripts/build-fonts.js",
    "build:deploy": "node scripts/build-deploy.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "server.js",
    "views",
    "config",
    "db",
    "models",
    "services",
    "public/css",
    "public/js",
    "scripts/init-db.js",
    "scripts/check-config.js",
    "scripts/build-deploy.js",
    ".env.example",
    "docs/SECURITY_REVIEW.md"
  ],
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "express": "4.22.3",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "3.24.4",
    "nodemailer": "10.0.10",
    "pngjs": "7.0.0",
    "qrcode": "^1.5.4"
  },
  "keywords": [
    "oauth2",
    "sso",
    "authentication",
    "enterprise"
  ],
  "author": "AzureKiln",
  "license": "MIT",
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/material-symbols-outlined": "5.3.6",
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.11",
    "playwright-core": "1.63.0",
    "tailwindcss": "3.4.19"
  }
}
