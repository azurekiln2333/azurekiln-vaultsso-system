# Database Configuration
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=vaultsso_oauth2

# Server Configuration
PORT=3146
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3146

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Token Expiry
TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d

# Session cookie scope. Set to your registrable domain (e.g. .azurekiln.cn) so
# subdomains such as the homepage or admin panel share the SSO session.
# Leave empty for a host-only cookie visible to this service only.
COOKIE_DOMAIN=

# Logout redirect allowlist. Comma-separated registrable domains (subdomains included).
# Example: LOGOUT_REDIRECT_HOSTS=azurekiln.cn lets /oauth2/logout?redirect=https://blog.azurekiln.cn return there.
# Leave empty to keep users on this service's login page after logout.
LOGOUT_REDIRECT_HOSTS=

# Email Verification
EMAIL_CODE_EXPIRY=10m
EMAIL_CODE_MAX_ATTEMPTS=5
MAIL_FROM=VaultSSO <no-reply@example.com>
# SMTP2GO example: SMTP_HOST=mail.smtp2go.com, SMTP_PORT=443 (implicit TLS).
# Leave SMTP_SECURE empty for auto detection (443/465 = implicit TLS, others = STARTTLS).
# SMTP_USER and SMTP_PASS must both be set, otherwise codes are printed to the console instead.
SMTP_HOST=
SMTP_PORT=443
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Development only: fixed 6-digit code for local tests. Do not set in production.
EMAIL_DEV_CODE=

# External OIDC login (for example Keycloak)
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=Keycloak
OIDC_PROVIDER_KEY=keycloak
# Optional JSON object for multiple providers. Values override the single-provider OIDC_* settings.
# Example: {"wechat":{"providerName":"微信","clientId":"...","clientSecret":"...","issuerUrl":"..."}}
OIDC_PROVIDERS_JSON=
OIDC_CLIENT_ID=
# Keep this value on the server only. Never expose it to frontend code.
OIDC_CLIENT_SECRET=
OIDC_ISSUER_URL=https://keycloak.example.com/realms/example
# Optional: overrides issuer discovery. Usually leave blank.
OIDC_DISCOVERY_URL=
OIDC_AUTHORIZE_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_JWKS_URL=
OIDC_SCOPES=openid profile email
OIDC_TOKEN_AUTH_METHOD=client_secret_basic
OIDC_CLOCK_TOLERANCE=60
OIDC_ALLOWED_ALGS=RS256 ES256
OIDC_PKCE_ENABLED=true
OIDC_VALIDATE_ID_TOKEN=true
OIDC_REQUIRE_EMAIL_VERIFIED=false
OIDC_USERINFO_EMAIL_PATH=email
OIDC_USERINFO_EMAIL_VERIFIED_PATH=email_verified
OIDC_USERINFO_ID_PATH=sub
OIDC_USERINFO_USERNAME_PATH=preferred_username
# Relative path only. It must not start with //.
OIDC_FRONTEND_CALLBACK_PATH=/oauth2/success
