# Production deployment. Supply credentials before starting the service.
# Loaded from the project root. Service/process environment variables take priority.
# Run npm run check:config to inspect configuration without printing secrets.
NODE_ENV=production
HOST=127.0.0.1
PORT=3146
PUBLIC_BASE_URL=https://login.example.com

# Generate a unique random secret of at least 32 bytes. No default is provided.
# This also protects stored credentials; back it up separately from the database.
JWT_SECRET=
# Persistent RSA private key, at least 2048 bits (3072 recommended).
# Keep it outside public/, and restrict access to the service account.
OIDC_SIGNING_KEY_FILE=
# Optional public JWKS for previous keys during signing-key rotation.
OIDC_PREVIOUS_JWKS_FILE=

# Optional Cloudflare Turnstile for enabled login/registration CAPTCHA checks.
# Initial defaults; both can also be managed from the admin security page.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional durable path for admin-edited SMTP and Turnstile settings (default: data/admin-settings.json).
# Keep this file outside public/, mount/back it up across deployments, and keep JWT_SECRET stable.
ADMIN_SETTINGS_FILE=

# Public content moderation service. Configure all three or leave all three empty.
# Provision a dedicated gateway app/secret in the service, separate from other apps.
# Nickname/description changes require SDK approval and fail with 503 when unavailable.
# Production requires HTTPS, except a loopback service; certificate verification stays enabled.
MODERATION_BASE_URL=
MODERATION_APP_ID=
MODERATION_API_KEY=

# Production cookies always require HTTPS. Leave COOKIE_DOMAIN empty for host-only cookies.
COOKIE_SECURE=true
COOKIE_DOMAIN=
# Comma-separated IP addresses/CIDRs of your actual reverse proxies.
# Defaults to local Nginx/Baota only. Explicit empty disables all proxy trust.
# External MySQL Compose mode uses host networking and keeps this localhost default.
# Bundled mode overrides this with GATEWAY_FRONT_GATEWAY/32 (see below).
# Never trust all Docker/private networks or use an unrestricted /0.
TRUST_PROXY=127.0.0.1/32,::1/128
# Allowed post-logout domains, including their subdomains; empty returns to the login page.
LOGOUT_REDIRECT_HOSTS=

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=oauth_app
DB_PASSWORD=
DB_NAME=azurekiln_oauth2
# Required for a remote production database. Certificate verification stays enabled.
DB_TLS=false
DB_TLS_CA_FILE=
# Production TLS exemption is only for the explicit private Compose service mysql:3306.
# Compose forces false for external mode and true for bundled mode. Do not enable for remote DBs.
DB_BUNDLED=false

# OAuth access/refresh token lifetimes, independent of browser login persistence.
TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d
# Absolute cap for legacy browser sessions only. New logins use the selected
# fixed 1/7/14-day duration (default: 1 day), starting after all factors succeed.
SESSION_ABSOLUTE_EXPIRY=12h
PASSWORD_MIN_LENGTH=12
EMAIL_CODE_EXPIRY=10m
EMAIL_CODE_MAX_ATTEMPTS=5

# Verification mail requires a working SMTP transport; codes are never printed to logs.
MAIL_FROM=AzureKiln <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
# Empty selects implicit TLS on 443/465, otherwise mandatory STARTTLS.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# OAuth clients and external identity providers are managed explicitly in the admin UI/database.
# Startup does not import provider definitions or application credentials from environment variables.

# Optional Docker Compose deployment (ignored by a plain Node process).
# Choose the published image for your own GitHub/CNB repository before pulling.
GATEWAY_IMAGE=docker.cnb.cool/azurekiln/azurekiln-oauth2:latest
COMPOSE_PROJECT_NAME=azurekiln-oauth2
# External mode (default, Linux host networking) uses HOST/PORT above unchanged.
# Bundled mode publishes only 127.0.0.1:GATEWAY_PORT; internal listener is 0.0.0.0:3146.
GATEWAY_PORT=3146
# Bundled only: change subnet AND gateway together if the default overlaps another network.
# TRUST_PROXY is set to this exact IPv4 gateway /32 in bundled mode.
GATEWAY_FRONT_SUBNET=172.30.46.0/24
GATEWAY_FRONT_GATEWAY=172.30.46.1
# Bundled only: use a separate generated root password. DB_NAME/DB_USER/DB_PASSWORD above
# initialize the application database/account on an EMPTY mysql-data volume only.
# Editing these values does not rotate passwords or reinitialize an existing volume.
MYSQL_ROOT_PASSWORD=
MYSQL_INNODB_BUFFER_POOL_SIZE=128M
MYSQL_MAX_CONNECTIONS=50
WATCHTOWER_POLL_INTERVAL=600
# Compose mounts .env read-only, data/ writable, and data/keys/ read-only (nested).
# Fonts/icons ship inside the image; no public/assets/ mount is needed.
# Use container-readable paths, e.g. OIDC_SIGNING_KEY_FILE=data/keys/oidc-private.pem.
# Paths outside data/keys/ (including the legacy top-level keys/) are rejected by the checker.
# ADMIN_SETTINGS_FILE is fixed to /app/data/admin-settings.json by Compose.
# External host mode: DB_HOST=127.0.0.1 reaches the existing host MySQL with no bind/grant changes.
# Bundled mode overrides DB_HOST/DB_PORT/DB_BUNDLED/DB_TLS; MySQL has no host port mapping.
# Watchtower is opt-in: scripts/deploy-docker.sh --watchtower, after manual validation.
# Keep registry credentials in CI secrets/platform auth or the operator's Docker login store.
